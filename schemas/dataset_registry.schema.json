{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Garmin Running Data Normalizer Dataset Registry",
  "type": "object",
  "required": ["registry_version", "status", "datasets"],
  "properties": {
    "registry_version": {"type": "string"},
    "status": {
      "enum": [
        "local_implementation_not_publication_ready",
        "stable_release_ready"
      ]
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_family", "record_grain", "stable_key", "merge_policy", "provenance_required"],
        "properties": {
          "name": {"type": "string"},
          "source_family": {"const": "garmin_account_export"},
          "record_grain": {"type": "string"},
          "stable_key": {"type": "array", "items": {"type": "string"}},
          "merge_policy": {"enum": ["entity_upsert", "temporal_event_union", "immutable_blob_union", "daily_state_upsert", "preserve_only"]},
          "provenance_required": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "candidate_datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "record_grain", "identity_anchor", "machine_stable_key_status", "publication_status", "observation_families", "merge_policy", "provenance_required"],
        "properties": {
          "name": {"type": "string"},
          "record_grain": {"type": "string"},
          "identity_anchor": {"const": "observation_timestamp"},
          "machine_stable_key_status": {"const": "PRODUCT_DECISION_REQUIRED"},
          "publication_status": {"const": "candidate_audit_only"},
          "observation_families": {
            "type": "array",
            "items": {"enum": ["history", "latest_snapshot", "profile_state", "derived_evidence"]},
            "minItems": 4,
            "uniqueItems": true
          },
          "merge_policy": {"const": "immutable_observation_union"},
          "provenance_required": {"const": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
